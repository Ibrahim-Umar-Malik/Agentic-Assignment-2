# Copy to .env and fill in. Never commit .env (it is git-ignored). Values here are placeholders only.

# --- models (open profile: Groq free tier serves the open-weight models in agent/config.yaml) ---
GIGBID_PROFILE=open            # open | open_local (Ollama) | paid | offline (no model calls; CI)
GROQ_API_KEY=
# OPENAI_API_KEY=              # paid profile only (optional)

# --- security ---
TOKEN_ENCRYPTION_KEY=          # python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MCP_SHARED_SECRET=             # any long random string; signs service tokens between the API and MCP servers
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
PUBLIC_BASE_URL=http://localhost:8080

# --- reviewer login (set on the host only; share the values privately in the GCR comment) ---
REVIEWER_EMAIL=
REVIEWER_PASSWORD=
REVIEWER_PERSONA=ai_ml

# --- storage (compose sets these; for single-container hosting point DATABASE_URL at a free Postgres) ---
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/gigbid
# REDIS_URL=redis://localhost:6379/0

# --- marketplace ---
GIGBID_MARKETPLACE=gigsim      # gigsim | upwork_live
GIGSIM_POLICY_VERSION=2        # change request: 2 Nov policy update
UPWORK_MCP_URL=https://mcp.upwork.com/mcp
UPWORK_CLIENT_ID=              # only if Upwork requires a registered client; otherwise dynamic client registration is used
UPWORK_CLIENT_SECRET=

# --- optional ---
GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/
GITHUB_MCP_TOKEN=              # fine-grained read-only token, used to ingest the freelancer's repos
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
