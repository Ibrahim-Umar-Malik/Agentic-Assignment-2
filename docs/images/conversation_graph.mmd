---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	context(context)
	intent(intent)
	liaison(liaison)
	compliance(compliance)
	preview(preview)
	approval(approval)
	send(send)
	__end__([<p>__end__</p>]):::last
	__start__ --> context;
	approval -.-> __end__;
	approval -.-> compliance;
	approval -.-> send;
	compliance --> preview;
	context --> intent;
	intent --> liaison;
	liaison --> compliance;
	preview --> approval;
	send --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
