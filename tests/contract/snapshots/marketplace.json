 "submit_proposal": {
  "annotations": {
   "destructiveHint": true,
   "idempotentHint": true,
   "openWorldHint": true,
   "readOnlyHint": false
  },
  "input": {
   "properties": {
    "draft_id": {
     "maxLength": 64,
     "minLength": 1,
     "title": "Draft Id",
     "type": "string"
    },
    "dry_run": {
     "default": false,
     "title": "Dry Run",
     "type": "boolean"
    },
    "idempotency_key": {
     "maxLength": 128,
     "minLength": 8,
     "pattern": "^[A-Za-z0-9:_\\-.]+$",
     "title": "Idempotency Key",
     "type": "string"
    },
    "job_id": {
     "maxLength": 64,
     "minLength": 1,
     "title": "Job Id",
     "type": "string"
    }
   },
   "required": [
    "draft_id",
    "job_id",
    "idempotency_key"
   ],
   "title": "submit_proposalArguments",
   "type": "object"
  },
  "output": {
   "properties": {
    "action": {
     "title": "Action",
     "type": "string"
    },
    "connects_balance_after": {
     "anyOf": [
      {
       "type": "integer"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Connects Balance After"
    },
    "connects_cost": {
     "anyOf": [
      {
       "type": "integer"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Connects Cost"
    },
    "marketplace": {
     "title": "Marketplace",
     "type": "string"
    },
    "preview": {
     "anyOf": [
      {
       "additionalProperties": true,
       "type": "object"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Preview"
    },
    "result": {
     "anyOf": [
      {
       "additionalProperties": true,
       "type": "object"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Result"
    },
    "status": {
     "enum": [
      "dry_run",
      "ok",
      "duplicate"
     ],
     "title": "Status",
     "type": "string"
    },
    "trace_id": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Trace Id"
    }
   },
   "required": [
    "status",
    "action",
    "marketplace"
   ],
   "title": "WriteResult",
   "type": "object"
  }
 }
}